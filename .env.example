APP_ENV=dev
APP_NAME=day13-observability-lab
LOG_LEVEL=INFO
LOG_PATH=data/logs.jsonl
AUDIT_LOG_PATH=data/audit.jsonl

# --- LLM provider ---
# mock  = FakeLLM có sẵn trong app/mock_llm.py (không tốn tiền, dùng cho lab)
# anthropic = gọi Claude API thật (cần ANTHROPIC_API_KEY, tốn tiền theo token)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Tuỳ chọn: low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=1024

# --- Langfuse (trace + prompt versioning) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=day13-chat
LANGFUSE_PROMPT_LABEL=production
